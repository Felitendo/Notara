# Copy this file to .env and adjust values as needed.
JWT_SECRET=supersecretkey # auto-generated and persisted in /data if not set
PG_HOST=localhost # leave empty to use embedded Postgres
PG_USER=notara
PG_PASSWORD=password
PG_DATABASE=notara
PG_PORT=5432

# Optional: Set to 'disabled', 'enabled', or 'review' to lock sign up mode.
# If not set, admins can control it via the admin panel.
# USER_SIGNUP=enabled

# Optional OIDC/SSO settings (all admin OIDC settings can be locked via env):
# If any of these are set (and not empty), the matching admin setting is locked.
# OIDC_ENABLED=false
# OIDC_PROVIDER_NAME=OIDC
# OIDC_ISSUER_URL=https://your-provider.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_ACCOUNT_LINKING=false
# OIDC_ADMIN_GROUP=
# DISABLE_PASSWORD_AUTH=false
# OIDC_AUTO_REDIRECT=false
